/* waybar-calendar styling — merge into ~/.config/waybar/style.css */

#custom-calendar {
    color: #aaaaaa;
    padding: 0 10px;
}

/* Next event is today */
#custom-calendar.today {
    color: #7aa2f7;
}

/* Next event is on a later day */
#custom-calendar.upcoming {
    color: #888888;
}

/* Next event is imminent (within CAL_SOON_MINS) */
#custom-calendar.soon {
    color: #e0af68;
}

/* No upcoming events — collapse the module */
#custom-calendar.none {
    padding: 0;
    margin: 0;
}

/* Google OAuth token expired or revoked - needs re-authorising by hand */
#custom-calendar.auth {
    color: #f7768e;
}

/* Fetching is failing (network, SSH) and the cache has aged past CAL_STALE_SECS */
#custom-calendar.stale {
    color: #c07a5a;
}
